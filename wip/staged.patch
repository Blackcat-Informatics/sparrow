+/// INVARIANT (issue #156; Patrick, 2026-11-08: Sparrow never backs up to a local disk):
+/// deploy/libexec/sparrow-backup refuses a backup root on a local filesystem before it creates
+/// anything or addresses a unit. An absent root is not created, and an existing one gains no
+/// lock, partial or backup. The unit named does not exist, so a refusal that came after the
+/// script's first systemctl call would name the unit instead.
+#[test]
+fn backup_refuses_a_local_backup_root_before_stopping_anything() {
+    let dir = tempfile::tempdir_in(env!("CARGO_TARGET_TMPDIR")).unwrap();
+    let (data, intake, runtime) = (
+        dir.path().join("store"),
+        dir.path().join("intake"),
+        dir.path().join("runtime"),
+    );
+    for path in [&data, &intake, &runtime] {
+        std::fs::create_dir_all(path).unwrap();
+    }
+    let config = write_server_config(dir.path(), &data, &data.join("rpc.sock"));
+    let run = |root: &Path| {
+        let output = Command::new(concat!(
+            env!("CARGO_MANIFEST_DIR"),
+            "/../../deploy/libexec/sparrow-backup"
+        ))
+        .arg(&config)
+        .arg(root)
+        .arg("3")
+        .arg(&intake)
+        .env("RUNTIME_DIRECTORY", &runtime)
+        .env("SPARROW_SCOPE", "user")
+        .env("SPARROW_UNIT", "sparrow-backup-refusal-test.service")
+        .env("SPARROW_PREFIX", dir.path())
+        .admitted_output()
+        .unwrap();
+        let stderr = String::from_utf8_lossy(&output.stderr).into_owned();
+        assert_eq!(output.status.code(), Some(1), "{stderr}");
+        assert!(
+            stderr.contains("not a network filesystem")
+                && !stderr.contains("sparrow-backup-refusal-test"),
+            "{stderr}"
+        );
+    };
+    let root = dir.path().join("backups");
+    run(&root);
+    assert!(!root.exists());
+    std::fs::create_dir(&root).unwrap();
+    run(&root);
+    assert_eq!(std::fs::read_dir(&root).unwrap().count(), 0);
+}
