+[Service]
+Environment=PATH=%h/.local/bin:/usr/bin
+ExecStart=%h/.local/libexec/sparrow/sparrow-backup %h/.config/sparrow/server.toml /SPARROW/intake %h/.config/sparrow /SPARROW/ship
+TimeoutStartSec=6h
