#!/usr/bin/python3 -I
# SPDX-FileCopyrightText: 2026 Blackcat Informatics® Inc. <paudley@blackcatinformatics.ca>
# SPDX-License-Identifier: MIT OR Apache-2.0 OR MulanPSL-2.0
"""Take an online backup of the running Sparrow daemon on the NAS and record its set.

Usage: sparrow-backup SERVER_CONFIG INTAKE [EXTRA...]

The backup is online (Patrick, 2026-11-08: "Backup may not: stop the server, pause the server,
or in any way perturb the ingestion"). This script never stops, signals or drains the daemon and
takes no lock the shipper or the daemon holds. It asks the daemon for a backup (`sparrow SOCKET
backup`): the daemon copies the live store with RocksDB's BackupEngine into backup_root/engine on
its own lowest-priority thread, without its writer lock and without a flush, so ingest continues
throughout. The script polls status every POLL_SECONDS until the backup completes or fails.

Sparrow never backs up to a local disk (Patrick, 2026-11-08). The backup root is the daemon's
backup_root, /net/synology/archives/sparrow in production; the script refuses a root that is not
on a network filesystem (nfs, nfs4, cifs or smb3) or that shares the store's filesystem before it
asks for anything, and the daemon applies the same rule.

Once the store is backed up, the files beside it are copied online into backup_root/sets/ID, where
ID is the engine's backup id: the image pair that runs the store (images/), the lexicon bundle it
reads (lexicons/), SERVER_CONFIG and each EXTRA (config/NAME), and INTAKE (intake/). They are
copied after the store's backup point, so they are as new as or newer than the store; see
deploy/RECOVERY.md, "Restore from a backup". SOURCE records the image, store identity, schema and
the backup id and times. MANIFEST.b3 holds the b3sum of every file of the set and of every engine
file the backup references, read back from the NAS after the copies are synchronized and their
cached pages dropped, with paths relative to backup_root. The set is written as ID.partial and
renamed into place only after the manifest is written. The run holds backup_root/.lock, the lock
deploy/lib.sh's image switches take, never the shipper's. Sets whose backup the engine has purged
(it keeps backup_keep) are removed. Any failure exits nonzero.
"""

import fcntl
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import time
import tomllib
from pathlib import Path

LIBEXEC = Path(os.environ.get("SPARROW_PREFIX", "/usr/local")) / "libexec" / "sparrow"
NETWORK_FILESYSTEMS = ("nfs", "nfs4", "cifs", "smb3")
POLL_SECONDS = 10
MANIFEST = "MANIFEST.b3"
# rsync exits 24 when a source file vanished during the transfer: a consumed intake file or a
# rotated shipper ledger, which is expected while the daemon runs.
RSYNC_VANISHED = 24
# No owners: a NAS export may squash them. Sockets and devices hold no data.
RSYNC = ["rsync", "-rlpt", "--no-D"]
ENGINE_FILE = re.compile(r"^(private|shared|shared_checksum)/\S+$")


def fail(message):
    sys.exit(f"sparrow-backup: {message}")


def note(message):
    print(f"sparrow-backup: {message}", flush=True)


def terminated(signum, _frame):
    raise SystemExit(f"sparrow-backup: stopped by signal {signum}; the daemon's backup, if "
                     "running, continues and the next run starts a new one")


def mount(path):
    """(fstype, MAJ:MIN) of the filesystem holding PATH."""
    shown = subprocess.run(["findmnt", "-no", "FSTYPE,MAJ:MIN", "-T", str(path)], check=True,
                           capture_output=True, text=True).stdout.split()
    if len(shown) != 2:
        fail(f"findmnt cannot name the filesystem of {path}")
    return shown[0], shown[1]


def require_network_root(root, data_dir):
    probe = root.absolute()
    while not probe.exists():
        probe = probe.parent
    fstype, device = mount(probe)
    if fstype not in NETWORK_FILESYSTEMS:
        fail(f"backup root {root} is on {fstype} ({probe}), not a network filesystem "
             f"({', '.join(NETWORK_FILESYSTEMS)}); Sparrow never backs up to a local disk. Mount "
             "the NAS archive first")
    if device == mount(data_dir)[1]:
        fail(f"backup root {root} shares the store's filesystem ({data_dir})")


def cli(socket, *args):
    run = subprocess.run(["sparrow", str(socket), *args], capture_output=True, text=True)
    if run.returncode != 0:
        fail(f"sparrow {socket} {' '.join(args)} failed: {(run.stderr or run.stdout).strip()}")
    return json.loads(run.stdout)


def copy(source, target, changing):
    """Copy SOURCE (a file or directory) to TARGET with rsync; a vanished file is accepted
    only where the tree changes while the daemon runs."""
    if source.is_dir():
        target.mkdir(mode=0o700)
        argv = [*RSYNC, "--", f"{source}/", f"{target}/"]
    else:
        argv = [*RSYNC, "--", str(source), str(target)]
    code = subprocess.run(argv).returncode
    if code != 0 and not (changing and code == RSYNC_VANISHED):
        fail(f"rsync of {source} to {target} exited {code}")


def drop_cached_pages(path):
    """Drop the cached pages of PATH's files, so the read-back reads the NAS."""
    files = [path] if path.is_file() else [entry for entry in path.rglob("*") if entry.is_file()]
    for entry in files:
        descriptor = os.open(entry, os.O_RDONLY)
        try:
            os.posix_fadvise(descriptor, 0, 0, os.POSIX_FADV_DONTNEED)
        finally:
            os.close(descriptor)


def hash_lines(base, names):
    """b3sum lines for NAMES, relative to BASE, read from the NAS."""
    lines = []
    for start in range(0, len(names), 256):
        chunk = names[start:start + 256]
        output = subprocess.run(["b3sum", "--", *chunk], cwd=base, check=True,
                                capture_output=True).stdout
        lines.extend(output.splitlines())
    for line in lines:
        if line.startswith(b"\\"):
            raise RuntimeError(f"b3sum escaped a path ({line!r}); the manifest cannot record it")
    return lines


def engine_files(root, backup_id):
    """The engine files backup BACKUP_ID references, relative to ROOT: its metadata file and
    every private and shared file the metadata lists."""
    meta = root / "engine" / "meta" / str(backup_id)
    files = [f"engine/meta/{backup_id}"]
    for line in meta.read_text().splitlines():
        fields = line.split()
        if fields and ENGINE_FILE.match(fields[0]):
            files.append(f"engine/{fields[0]}")
    if len(files) == 1:
        fail(f"{meta} lists no file")
    return files


def fsync_directory(path):
    descriptor = os.open(path, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def write_durable(path, data):
    with open(path, "wb") as handle:
        handle.write(data)
        handle.flush()
        os.fsync(handle.fileno())


def instant(millis):
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(millis / 1000))


def main(server_config, intake, extra):
    signal.signal(signal.SIGTERM, terminated)
    with open(server_config, "rb") as handle:
        server = tomllib.load(handle)
    data_dir, socket = Path(server["data_dir"]), Path(server["socket_path"])
    if "backup_root" not in server:
        fail(f"{server_config} sets no backup_root; the daemon backs up only into its configured "
             "root on the NAS")
    root = Path(server["backup_root"])
    # The root is judged before anything else is needed or asked of the daemon.
    if shutil.which("findmnt") is None:
        fail("findmnt is missing; it tells whether the backup root is on the NAS")
    require_network_root(root, data_dir)
    for tool in ("rsync", "b3sum", "sparrow"):
        if shutil.which(tool) is None:
            fail(f"{tool} is missing; the backup needs it")

    # The deployment's backup lock (deploy/lib.sh, hold_backup_lock): start.sh and restart.sh
    # switch no image while a run records the image link. It is not the shipper's lock.
    root.mkdir(mode=0o700, parents=True, exist_ok=True)
    lock = open(root / ".lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        fail(f"another backup run holds {root / '.lock'}")

    started = time.monotonic()
    running = cli(socket, "backup")
    if running["phase"] != "running":
        fail(f"the daemon did not start a backup: {running}")
    started_at = running["started_at"]
    note(f"the daemon is backing up its store online into {running['root']} (started "
         f"{started_at}); polling status every {POLL_SECONDS}s")
    while True:
        time.sleep(POLL_SECONDS)
        status = cli(socket, "status")
        backup = status["backup"]
        if backup["started_at"] != started_at:
            fail(f"status no longer reports the backup started at {started_at} (it reports "
                 f"{backup}); the daemon restarted or another backup replaced it")
        if backup["phase"] == "failed":
            fail(f"the daemon's backup failed: {backup['failure']}")
        if backup["phase"] == "complete":
            break
        if backup["phase"] != "running":
            fail(f"the daemon reports backup phase {backup['phase']}")
    engine_seconds = time.monotonic() - started
    backup_id = backup["backup_id"]
    note(f"store backup {backup_id} complete and verified by the engine: {backup['files']} files, "
         f"{backup['bytes']} bytes, in {engine_seconds:.1f}s")

    sets = root / "sets"
    sets.mkdir(mode=0o700, exist_ok=True)
    final = sets / str(backup_id)
    partial = sets / f"{backup_id}.partial"
    if final.exists():
        fail(f"{final} already exists")
    for leftover in sets.glob("*.partial"):
        note(f"removing the unfinished {leftover}")
        shutil.rmtree(leftover)
    partial.mkdir(mode=0o700)
    # The image pair the unit runs: start.sh and restart.sh point this link at the image they
    # start, so a restore needs nothing from ./bin.
    image = os.readlink(LIBEXEC / "sparrowd")
    image_cli = "sparrow-" + image.removeprefix("sparrowd-")
    # The link must name the image that serves the store, or SOURCE would record the wrong one.
    named = re.fullmatch(r"sparrowd-schema(\d+)-\S+", image)
    if named is None:
        fail(f"{LIBEXEC / 'sparrowd'} names {image}, not a sparrowd-schemaN-REV image")
    if int(named[1]) != int(status["schema_version"]):
        fail(f"{LIBEXEC / 'sparrowd'} names schema {named[1]} ({image}), but the running daemon "
             f"reports schema {status['schema_version']}; the link moved since it started")
    (partial / "images").mkdir()
    for name in (image, image_cli):
        copy(LIBEXEC / name, partial / "images" / name, changing=False)
    bundle = Path(server["text_lexicon_dir"]).parent
    (partial / "lexicons").mkdir()
    copy(bundle, partial / "lexicons" / bundle.name, changing=False)
    (partial / "config").mkdir()
    for path in [server_config, *extra]:
        copy(path, partial / "config" / path.name, changing=path.is_dir())
    copy(intake, partial / "intake", changing=True)
    write_durable(partial / "SOURCE", (
        f"backup_id={backup_id}\nstore_id={status['store_id']}\n"
        f"schema_version={status['schema_version']}\nstore_format={status['store_format']}\n"
        f"image={image}\ncli={image_cli}\ntaken_utc={started_at}\n"
        f"finished_utc={backup['finished_at']}\nsets_copied_utc={instant(time.time() * 1000)}\n"
        f"engine_files={backup['files']}\nengine_bytes={backup['bytes']}\n"
        f"data_dir={data_dir}\nintake={intake}\ntext_lexicon_dir={server['text_lexicon_dir']}\n"
    ).encode())
    subprocess.run(["sync", "--file-system", str(partial)], check=True)
    # Read back from the NAS: the set's files under their final names, then the engine files.
    drop_cached_pages(partial)
    drop_cached_pages(root / "engine")
    names = sorted(str(entry.relative_to(partial)) for entry in partial.rglob("*")
                   if entry.is_file())
    prefix = f"sets/{backup_id}/".encode()
    lines = [line[:66] + prefix + line[66:] for line in hash_lines(partial, names)]
    lines += hash_lines(root, engine_files(root, backup_id))
    write_durable(partial / MANIFEST, b"".join(line + b"\n" for line in sorted(lines)))
    fsync_directory(partial)
    os.rename(partial, final)
    fsync_directory(sets)
    # The engine purged its oldest backups past backup_keep; their sets go with them.
    kept = {entry.name for entry in (root / "engine" / "meta").iterdir()
            if entry.name.isdigit()}
    for old in sets.iterdir():
        if old.name.isdigit() and old.name not in kept:
            shutil.rmtree(old)
    note(f"{final} complete: {len(lines)} files in {MANIFEST} read back from the NAS; "
         f"{len(kept)} backup(s) kept; {time.monotonic() - started:.1f}s in all")


if __name__ == "__main__":
    if len(sys.argv) < 3:
        fail("usage: sparrow-backup SERVER_CONFIG INTAKE [EXTRA...]")
    main(Path(sys.argv[1]), Path(sys.argv[2]), [Path(arg) for arg in sys.argv[3:]])
