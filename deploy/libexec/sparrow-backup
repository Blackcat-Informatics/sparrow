#!/usr/bin/python3 -I
# SPDX-FileCopyrightText: 2026 Blackcat Informatics® Inc. <paudley@blackcatinformatics.ca>
# SPDX-License-Identifier: MIT OR Apache-2.0 OR MulanPSL-2.0
"""Take a closed-store backup of the running Sparrow service and prune old ones.

Sparrow has no online checkpoint, so a consistent copy needs a closed store.
The service is stopped (SIGINT drains workers and fences the WAL), `data_dir`,
the consume intake roots and the deployment configuration are copied, and the
service is started again. On btrfs the copy is a reflink: it completes in
seconds whatever the store size, and later store writes never change it. A
backup directory is renamed into place only after every file is copied and
synchronized, so a partial copy is never mistaken for a backup.

An unfinished consume claim binds the inode of its intake root and claimed
file, which a restored copy cannot reproduce. Before stopping the service the
backup therefore waits for consumption to drain: it runs under the shipper's
lock, so no new files arrive, and waits until every intake root is empty and
every watch reports no pending claims. Files are never moved under the running
daemon, whose reserved claims bind each file's identity.

Each backup records in SOURCE the image that last opened the store, with the
store's identity, schema, format, live records and stored payload chunks, and keeps that image pair under images/
and the lexicon bundle it reads under lexicons/, so `deploy/start.sh --restored-from BACKUP` can start exactly that image. Only
timestamp-named backups are pruned; a copy under another name (README.md,
"Upgrades and rollback": pre-upgrade-IMAGE) is kept until removed by hand.

The script refuses to touch a service that is not running. Once it has stopped
the service it always restarts it, including after a failure or a SIGTERM; the
unit's ExecStopPost restarts it after a SIGKILL, guided by a marker file. Any
failure exits nonzero so the systemd unit records it.
"""

import fcntl
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import time
import tomllib
from pathlib import Path

# The unit and its manager, and where the image links live; the defaults are the production ones,
# and deploy/lib.sh reads the same variables, so a test instance (deploy/test-instance.sh) can drive
# this script too.
UNIT = os.environ.get("SPARROW_UNIT", "sparrow.service")
SCOPE = os.environ.get("SPARROW_SCOPE", "system")
LIBEXEC = Path(os.environ.get("SPARROW_PREFIX", "/usr/local")) / "libexec" / "sparrow"
STAMP = re.compile(r"^[0-9]{8}T[0-9]{6}Z$")
QUIESCE_SECONDS = 30 * 60
# The unit's RuntimeDirectory=; its ExecStopPost reads the same name.
MARKER_NAME = "stopped"


def fail(message):
    sys.exit(f"sparrow-backup: {message}")


def systemctl_command():
    if SCOPE not in ("system", "user"):
        fail(f"SPARROW_SCOPE must be system or user, not {SCOPE}")
    # systemctl reads "sparrow" as "sparrow.service", so both spellings are refused.
    if SCOPE == "user" and UNIT.removesuffix(".service") == "sparrow":
        fail("SPARROW_SCOPE=user needs SPARROW_UNIT naming a test unit, never sparrow.service")
    return ["systemctl"] + (["--user"] if SCOPE == "user" else [])


def systemctl(*args):
    subprocess.run([*systemctl_command(), *args], check=True)


def du(path):
    return sum(entry.stat().st_size for entry in path.rglob("*") if entry.is_file())


def copy_tree(source, target):
    subprocess.run(["cp", "-a", "--reflink=auto", "--", str(source), str(target)], check=True)


def sync_tree(path):
    subprocess.run(["sync", "--file-system", str(path)], check=True)


def terminated(signum, _frame):
    raise SystemExit(f"sparrow-backup: stopped by signal {signum}")


def fsync_directory(path):
    directory = os.open(path, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(directory)
    finally:
        os.close(directory)


def daemon_status(socket):
    """The daemon's typed status, from the CLI."""
    status = subprocess.run(["sparrow", str(socket), "status"], check=True,
                            capture_output=True, text=True)
    return json.loads(status.stdout)


def pending_claims(socket):
    """Sum pending consume claims from the daemon's status."""
    return sum(watch["pending_claims"] for watch in daemon_status(socket)["consume_watches"])


def selected_image():
    """The daemon image the unit runs: start.sh and restart.sh point this link at the image they
    start, and refuse to leave it naming any other while the unit runs."""
    link = LIBEXEC / "sparrowd"
    try:
        return os.readlink(link)
    except OSError as error:
        fail(f"cannot read the image link {link}: {error}")


def waiting_files(intake):
    """Count regular files still awaiting consumption in the intake roots."""
    count = 0
    for root in intake.iterdir():
        if root.is_dir() and not root.name.startswith("."):
            count += sum(1 for entry in root.iterdir()
                         if not entry.name.startswith(".") and entry.is_file())
    return count


def main(server_config, backup_root, keep, intake, extra):
    runtime = os.environ.get("RUNTIME_DIRECTORY")
    if not runtime or not Path(runtime).is_dir():
        fail("RUNTIME_DIRECTORY is not set to a directory; run through sparrow-backup.service "
             "or set it as deploy/MANUAL.md shows")
    marker = Path(runtime) / MARKER_NAME
    signal.signal(signal.SIGTERM, terminated)
    with open(server_config, "rb") as handle:
        server = tomllib.load(handle)
    data_dir, socket = Path(server["data_dir"]), Path(server["socket_path"])
    if not data_dir.is_dir():
        fail(f"data_dir {data_dir} is missing")
    if subprocess.run([*systemctl_command(), "is-active", "--quiet", UNIT]).returncode != 0:
        fail(f"{UNIT} is not running; refusing to stop or start it")
    backup_root.mkdir(parents=True, exist_ok=True)
    if backup_root.resolve().is_relative_to(data_dir.resolve()):
        fail("backup_root must not be inside data_dir")
    lock = open(backup_root / ".lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        fail("another backup run holds the lock")
    # Guard against filling the disk if reflinks are unavailable or extents diverged.
    free = shutil.disk_usage(backup_root).free
    needed = 2 * du(data_dir) + 10 * 1024**3
    if free < needed:
        fail(f"only {free} bytes free under {backup_root}; need {needed}")
    stamp = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
    partial = backup_root / f".partial-{stamp}"
    final = backup_root / stamp
    if final.exists():
        fail(f"{final} already exists")
    for leftover in backup_root.glob(".partial-*"):
        shutil.rmtree(leftover)
    partial.mkdir()
    stopped = False
    try:
        # Everything that does not change while the daemon runs is copied first, before the drain
        # wait, so the closed-store window holds only the store and the intake, and nothing slow
        # runs between the drain check and the stop.
        prepared = time.monotonic()
        image = selected_image()
        # The image pair that last opened the store, so a restore needs nothing from ./bin.
        images = partial / "images"
        images.mkdir()
        for name in (image, "sparrow-" + image.removeprefix("sparrowd-")):
            shutil.copy2(LIBEXEC / name, images / name)
        # And the lexicon bundle it reads (text_lexicon_dir is the bundle's artifacts directory).
        bundle = Path(server["text_lexicon_dir"]).parent
        (partial / "lexicons").mkdir()
        copy_tree(bundle, partial / "lexicons" / bundle.name)
        config = partial / "config"
        config.mkdir()
        for path in [server_config, *extra]:
            if path.is_dir():
                copy_tree(path, config / path.name)
            else:
                shutil.copy2(path, config / path.name)
        prepared = time.monotonic() - prepared
        waited = time.monotonic()
        while waiting_files(intake) or pending_claims(socket):
            if time.monotonic() - waited > QUIESCE_SECONDS:
                raise RuntimeError(
                    f"intake not drained after {QUIESCE_SECONDS}s: {waiting_files(intake)} "
                    f"file(s) waiting, {pending_claims(socket)} claim(s) pending")
            time.sleep(5)
        waited = time.monotonic() - waited
        # Which image last opened this store, so a restore can start exactly that image
        # (deploy/start.sh --restored-from) rather than one that would upgrade it.
        status = daemon_status(socket)
        if selected_image() != image:
            raise RuntimeError(f"the image link moved from {image} during the backup")
        # The link must name the image that runs: its schema number is the running daemon's.
        named = re.fullmatch(r"sparrowd-schema([0-9]+)-.+", image)
        if named is None or int(named.group(1)) != status["schema_version"]:
            raise RuntimeError(f"the image link names {image}, but the running daemon reports "
                               f"schema {status['schema_version']}; the link does not name it")
        (partial / "SOURCE").write_text(
            f"data_dir={data_dir}\nserver_config={server_config}\nintake={intake}\n"
            f"taken_utc={stamp}\ndrain_seconds={waited:.0f}\n"
            "waiting_files=0\npending_claims=0\n"
            f"image={image}\nstore_id={status['store_id']}\n"
            f"schema_version={status['schema_version']}\nstore_format={status['store_format']}\n"
            f"live_records={int(status['live_records'])}\n"
            f"unique_payload_chunks={int(status['unique_payload_chunks'])}\n"
            + "".join(f"extra={path}\n" for path in extra)
        )
        marker.write_text(f"{os.getpid()}\n")
        started = time.monotonic()
        stopped = True
        systemctl("stop", UNIT)
        stop_seconds = time.monotonic() - started
        copy_tree(data_dir, partial / "store")
        copy_tree(intake, partial / "intake")
        copy_seconds = time.monotonic() - started - stop_seconds
    finally:
        if stopped:
            systemctl("start", UNIT)
            marker.unlink(missing_ok=True)
    # Report success only once the restarted daemon answers on its socket.
    deadline = time.monotonic() + 120
    while True:
        try:
            daemon_status(socket)
            break
        except (subprocess.CalledProcessError, json.JSONDecodeError):
            if time.monotonic() > deadline:
                fail(f"{UNIT} restarted but did not answer status within 120s")
            time.sleep(1)
    downtime = time.monotonic() - started
    ready_seconds = downtime - stop_seconds - copy_seconds
    # The copy becomes durable after the daemon is back, and before the rename publishes it.
    synced = time.monotonic()
    sync_tree(partial)
    sync_seconds = time.monotonic() - synced
    os.rename(partial, final)
    fsync_directory(backup_root)
    backups = sorted(path for path in backup_root.iterdir() if STAMP.match(path.name))
    for old in backups[:-keep]:
        shutil.rmtree(old)
    print(f"sparrow-backup: phases: drain wait {waited:.1f}s, copy before stop {prepared:.1f}s, "
          f"stop {stop_seconds:.1f}s, closed copy {copy_seconds:.1f}s, restart until ready "
          f"{ready_seconds:.1f}s, sync {sync_seconds:.1f}s")
    print(f"sparrow-backup: {final} complete; {downtime:.1f}s service downtime; "
          f"kept {min(len(backups), keep)} backup(s)")


if __name__ == "__main__":
    if len(sys.argv) < 5:
        fail("usage: sparrow-backup SERVER.toml BACKUP_ROOT KEEP INTAKE_ROOT [EXTRA_PATH...]")
    keep = int(sys.argv[3])
    if keep < 1:
        fail("KEEP must be at least 1")
    paths = [Path(path) for path in sys.argv[4:]]
    for path in paths:
        if not path.exists():
            fail(f"{path} does not exist")
    main(Path(sys.argv[1]), Path(sys.argv[2]), keep, paths[0], paths[1:])
