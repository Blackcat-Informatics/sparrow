# The namespace forwarder, kept here from issue #168 on (it ran only from ~/.local/libexec before).
# Follow one system-journal unit and spool it as JSON Lines in ten-minute files for sparrow-ship.
# Usage: katamari-journal-spool UNIT SPOOL_DIR CURSOR_FILE
# The bucket comes from the entry's own timestamp, so a backfill lands in the right files.
set -euo pipefail
unit=${1:?unit} dir=${2:?spool dir} cursor=${3:?cursor file}
# The namespace journal is a different journal, so it gets its own cursor file; the original file stays as the default-journal record.
cursor=${cursor%.cursor}-ns.cursor
prefix=${unit%.service}
(umask 077 && mkdir -p -- "$dir")
journalctl --namespace=katamari --unit="$unit" --output=json --cursor-file="$cursor" --follow --lines=all --no-pager |
  jq -r --unbuffered --arg unit "$unit" '
(.MESSAGE | if type == "string" then . else tostring end) as $m
| (.__REALTIME_TIMESTAMP | tonumber) as $us
| ($m | [match("(?:^| )vault=[^ ]*"; "g")] | first // null | if . then .string else null end) as $tok
| {
    event: ($m | split(" ")[0]),
    vault: (if $tok then (($tok | capture("vault=(?<v>[a-z2-7]{26})$") | .v) // null) else null end),
    vault_name: (($m | capture("name=\"(?<n>[^\"]*)\"") | .n) // null),
    priority: ((.PRIORITY // "6") | tonumber),
    realtime_usec: $us,
    time: ($us / 1000000 | todate),
    unit: $unit,
    message: $m
  }
| with_entries(select(.value != null))
| ((($us / 1000000 | floor) / 600 | floor) * 600 | strftime("%Y%m%dT%H%M")) as $bucket
| "\($bucket)\t\(tojson)"' |
  while IFS=$'\t' read -r bucket line; do
    printf '%s\n' "$line" >> "$dir/$prefix-$bucket.jsonl"
  done
