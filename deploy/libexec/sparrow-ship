#!/usr/bin/python3 -I
# SPDX-FileCopyrightText: 2026 Blackcat Informatics® Inc. <paudley@blackcatinformatics.ca>
# SPDX-License-Identifier: MIT OR Apache-2.0 OR MulanPSL-2.0
"""Copy finished producer files into Sparrow consume roots without touching originals.

Consume watches take ownership of a file and delete it after publication, so a
producer's own directory must never be a consume root. This shipper reads each
configured source directory, selects files the producer has finished writing,
and copies them into a private queue under `state_dir/queue/NAME`. Each run then
feeds queued items into `intake_root/NAME`, where a consume watch with the same
NAME ingests and removes them. Originals are only read.

Small files are reflink copies, which share extents on btrfs. Line-oriented files
above the chunk limits are split on line boundaries so that no artifact can
exceed the per-artifact record limit or the consume publication deadline; a
refused publication would otherwise be retried indefinitely. Every other format
is shipped whole up to `MAX_IMPORT_BYTES`, about 7.93 GiB, the largest artifact
whose catalog row one Sparrow retirement pass can read, until the v2 store format
(#5). Sparrow splits a whole
document above 128 MiB into raw records itself. A larger file is reported as a
failure on every run and never queued, because Sparrow refuses it before upload.

Feeding keeps the bytes waiting in all consume roots together within
`max_pending_bytes`, so a store stop's drain wait stays bounded however large a
source file is. An item larger than the budget is fed only when every consume
root is empty, and then alone.

A ledger per source records each shipped identity (inode, size and modification
time) after all of its copies are durably queued. The device number is not part
of it, because it can change at boot (btrfs renumbers it), which would ship every
file again. Older ledger lines carry the device as a fourth, leading field and
are read as the same entry. Inode reuse after a delete and create is not
detected, and the device number never detected that either. A crash between
queueing and recording the identity queues the file again; an identical item already waiting in a root
is recognized and dropped, and a different one waits until Sparrow consumes the
earlier copy. A finished file that later changes has a new identity and is
shipped again whole.

A source with `delete_acknowledged = true` is a spool the shipper owns, and the
shipper deletes one of its finished files once the store holds every byte of it.
The acknowledgement is the store's payload-id index: each part the file ships as
(the whole file, or each line-bounded part) is hashed with BLAKE3 and looked up
with `sparrow SOCKET payload STORE blake3:HEX`. A file is deleted only when every
part lists at least one artifact, which the store answers only while it holds all
of that artifact's bytes. Nothing else removes a file. A file still queued,
waiting in a consume root, refused under storage pressure or quarantined has no
held artifact, so it stays. While the store is unreachable nothing is deleted,
however long that lasts, and the run reports it without failing. A file whose
parts the store once held but has since retired also stays.
"""

import fcntl
import filecmp
import json
import os
import shutil
import subprocess
import sys
import time
import tomllib
from pathlib import Path

RULES = ("daily", "sealed", "settled")
# sparrow_core::MAX_IMPORT_BYTES: the largest input one retirement pass can read back
# as an artifact. A Rust test asserts that this literal equals the constant.
MAX_IMPORT_BYTES = 8515420160
LINE_FORMATS = ("jsonl", "log")


def fail(message):
    sys.exit(f"sparrow-ship: {message}")


def refuse_overlap(path, source, config):
    """Refuse a source directory that equals, contains or lies inside the shipper's own trees.

    The shipper writes `intake_root` and `state_dir`; a source that overlaps either would
    ship its own queue, ledgers or consumed items again on every run. Real paths are
    compared, so a symlink cannot hide the overlap; the two output trees may not exist yet.
    """
    directory = Path(source["dir"]).resolve()
    for key in ("intake_root", "state_dir"):
        tree = Path(config[key]).resolve()
        if directory == tree or directory.is_relative_to(tree) or tree.is_relative_to(directory):
            fail(f"{path}: source {source['name']}: dir {source['dir']} (real path {directory}) "
                 f"overlaps {key} {config[key]} (real path {tree}); a source directory may not "
                 f"equal, contain or lie inside {key}. Move the source or change {key}")


def load_config(path):
    with open(path, "rb") as handle:
        config = tomllib.load(handle)
    if "max_whole_bytes" in config:
        fail(f"{path}: `max_whole_bytes` was removed; unsplittable formats now ship whole "
             f"up to Sparrow's {MAX_IMPORT_BYTES}-byte import bound. Delete the key and rerun")
    for key in ("intake_root", "state_dir", "max_chunk_bytes", "max_chunk_lines",
                "max_files_per_run", "max_pending_bytes", "max_queue_bytes"):
        if key not in config:
            fail(f"{path}: missing required key `{key}`")
    names = set()
    for source in config.get("source", []):
        for key in ("name", "dir", "pattern", "rule", "format", "settle_seconds"):
            if key not in source:
                fail(f"{path}: source missing required key `{key}`")
        if source["rule"] not in RULES:
            fail(f"{path}: source {source['name']}: rule must be one of {RULES}")
        if source["name"] in names or "/" in source["name"] or source["name"].startswith("."):
            fail(f"{path}: source names must be unique plain directory names")
        names.add(source["name"])
        if not Path(source["dir"]).is_dir():
            fail(f"source {source['name']}: {source['dir']} is not a readable directory")
        refuse_overlap(path, source, config)
    if not names:
        fail(f"{path}: no [[source]] entries")
    reaping = [source["name"] for source in config["source"]
               if source.get("delete_acknowledged", False)]
    for source in config["source"]:
        if not isinstance(source.get("delete_acknowledged", False), bool):
            fail(f"{path}: source {source['name']}: delete_acknowledged must be true or false")
    if reaping:
        for key in ("sparrow", "socket"):
            if key not in config:
                fail(f"{path}: sources {reaping} set delete_acknowledged, which needs the "
                     f"top-level key `{key}` (the sparrow CLI and the store socket it queries)")
        if not os.access(config["sparrow"], os.X_OK):
            fail(f"{path}: sparrow {config['sparrow']} is not an executable file; "
                 "set `sparrow` to the installed CLI")
        if shutil.which("b3sum") is None:
            fail(f"{path}: sources {reaping} set delete_acknowledged, which hashes parts with "
                 "b3sum; install b3sum (package b3sum) or remove the key")
    return config


def identity(stat):
    return f"{stat.st_ino}:{stat.st_size}:{stat.st_mtime_ns}"


def ledger_keys(ledger_path):
    """Return the identities a ledger records, reading legacy `dev:` lines as the same entry."""
    keys = set()
    # The writer ends lines with "\n" only. Neither splitlines() nor universal-newline
    # reading may split a file name that holds a carriage return or another separator.
    with open(ledger_path, newline="") as handle:
        lines = handle.read().split("\n")
    if lines[-1] == "":
        lines.pop()
    for number, line in enumerate(lines, 1):
        key = line.split("\t", 1)[0]
        fields = key.split(":")
        if len(fields) == 4:
            fields = fields[1:]
        elif len(fields) != 3:
            fail(f"{ledger_path}:{number}: ledger key {key!r} must be inode:size:mtime_ns "
                 "(or the older dev:inode:size:mtime_ns); repair or remove the line")
        keys.add(":".join(fields))
    return keys


def is_regular(stat):
    return (stat.st_mode & 0o170000) == 0o100000


def fsync_directory(path):
    directory = os.open(path, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(directory)
    finally:
        os.close(directory)


def finished(source, now):
    """Return (path, stat) for files the producer has finished, oldest name first."""
    directory = Path(source["dir"])
    candidates = sorted(
        path for path in directory.glob(source["pattern"])
        if not path.name.startswith(".") and path.name not in source.get("exclude", [])
    )
    if source["rule"] == "daily" and candidates:
        # The newest dated file may still be appended to.
        candidates = candidates[:-1]
    selected = []
    for path in candidates:
        try:
            stat = path.lstat()
        except FileNotFoundError:
            continue
        if not is_regular(stat):
            continue
        if now - stat.st_mtime < source["settle_seconds"]:
            continue
        if source["rule"] == "sealed" and not path.with_name(path.name + ".manifest.json").is_file():
            continue
        selected.append((path, stat))
    return selected


def waiting(directory):
    """Return (name, size) for regular non-hidden files, tolerating concurrent removal."""
    files = []
    for entry in os.scandir(directory):
        if entry.name.startswith("."):
            continue
        try:
            stat = entry.stat(follow_symlinks=False)
        except FileNotFoundError:
            continue  # Sparrow claimed the file during the scan.
        if is_regular(stat):
            files.append((entry.name, stat.st_size))
    return sorted(files)


def chunks(path, max_bytes, max_lines):
    """Yield successive lists of complete lines bounded by bytes and line count."""
    lines, size = [], 0
    with open(path, "rb") as handle:
        for line in handle:
            if lines and (size + len(line) > max_bytes or len(lines) >= max_lines):
                yield lines
                lines, size = [], 0
            lines.append(line)
            size += len(line)
    if lines:
        yield lines


def pieces(source, path, stat, config):
    """Return None when the file ships whole, else an iterator of its line-bounded parts."""
    max_bytes, max_lines = config["max_chunk_bytes"], config["max_chunk_lines"]
    if source["format"] not in LINE_FORMATS:
        return None
    if stat.st_size <= max_bytes:
        with open(path, "rb") as handle:
            if handle.read().count(b"\n") <= max_lines:
                return None
    return chunks(path, max_bytes, max_lines)


def enqueue(source, path, stat, config, queue, staging):
    """Stage a complete copy of one finished file, verify it, then queue it durably.

    Queue names carry an order prefix; the name fed into the consume root drops it.
    """
    flat = str(path.relative_to(source["dir"])).replace("/", "__")
    parts = pieces(source, path, stat, config)
    whole = parts is None
    if whole and stat.st_size > MAX_IMPORT_BYTES:
        raise RuntimeError(f"{stat.st_size} bytes exceeds Sparrow's {MAX_IMPORT_BYTES}-byte "
                           "import bound (about 7.93 GiB); split the file and ship the parts")
    order = f"{time.time_ns():020d}"
    staged, written = [], 0
    if whole:
        staged.append(staging / f"{order}-00000-{flat}")
        subprocess.run(["cp", "--reflink=auto", "--", str(path), str(staged[0])], check=True)
        written = staged[0].stat().st_size
    else:
        stem, dot, suffix = flat.rpartition(".")
        if not dot:
            stem, suffix = flat, source["format"]
        for index, lines in enumerate(parts):
            staged.append(staging / f"{order}-{index:05d}-{stem}.part{index:05d}.{suffix}")
            with open(staged[-1], "wb") as handle:
                handle.writelines(lines)
                written += handle.tell()
    if written != stat.st_size or identity(path.stat()) != identity(stat):
        for leftover in staged:
            leftover.unlink()
        raise RuntimeError(f"{path} changed while it was copied")
    for item in staged:
        # The daemon runs as its own user and reads the item through its group:
        # state_dir is setgid to that group, and a reflink copy takes the
        # producer's mode, which may give the group nothing. Set it explicitly.
        os.chmod(item, 0o640)
        with open(item, "rb") as handle:
            os.fsync(handle.fileno())
    for item in staged:
        os.rename(item, queue / item.name)
    fsync_directory(queue)
    return written


def feed(config, intake, queues):
    """Move queued items into consume roots while all roots stay within the budget."""
    budget = config["max_pending_bytes"]
    pending = sum(size for name in queues for _, size in waiting(intake / name))
    fed = dict.fromkeys(queues, 0)
    blocked = set()
    progress = True
    while progress:
        progress = False
        for name, queue in queues.items():
            if name in blocked:
                continue
            items = waiting(queue)
            if not items:
                continue
            item, size = items[0]
            root = intake / name
            target = root / item.split("-", 2)[2]
            if target.exists():
                try:
                    same = filecmp.cmp(queue / item, target, shallow=False)
                except FileNotFoundError:
                    blocked.add(name)  # Sparrow claimed the earlier copy; decide next run.
                    continue
                if same:
                    (queue / item).unlink()  # Placed by an interrupted earlier run.
                    fsync_directory(queue)
                    progress = True
                else:
                    blocked.add(name)  # Wait until Sparrow consumes the earlier copy.
                continue
            if pending and pending + size > budget:
                return fed
            os.rename(queue / item, target)
            fsync_directory(root)
            fsync_directory(queue)
            pending += size
            fed[name] += 1
            progress = True
    return fed


class StoreUnreachable(Exception):
    """The store did not answer; no file may be deleted on its behalf."""


class Store:
    """Payload-id lookups through the sparrow CLI against one store socket."""

    def __init__(self, config):
        self.command = [config["sparrow"], config["socket"]]
        self.store_id = self.query(["discover"])["store_id"]

    def query(self, arguments):
        result = subprocess.run(self.command + arguments, capture_output=True)
        if result.returncode != 0:
            reason = result.stderr.decode(errors="replace").strip().splitlines()
            raise StoreUnreachable(reason[-1] if reason else f"exit {result.returncode}")
        return json.loads(result.stdout)

    def holds(self, digest):
        """Whether the store holds every byte of at least one artifact with this BLAKE3 digest."""
        page = self.query(["payload", self.store_id, f"blake3:{digest}", "--page-size", "1"])
        return bool(page["artifact_ids"])


def blake3(data=None, path=None):
    argv = ["b3sum", "--no-names"] + (["--", str(path)] if path else [])
    result = subprocess.run(argv, input=data, capture_output=True, check=True)
    return result.stdout.decode().strip()


REAP_PREFIX = ".reaping-"


def restore(aside):
    """Put a file set aside for deletion back under its own name, never over another file."""
    original = aside.with_name(aside.name[len(REAP_PREFIX):])
    try:
        os.link(aside, original)
    except FileExistsError:
        raise RuntimeError(f"{aside} was set aside for deletion and {original} exists again; "
                           "both may hold unsent lines, so neither is deleted: append "
                           f"{aside} to {original} and remove it") from None
    aside.unlink()


def restore_leftovers(source):
    """Put back every file an interrupted run set aside; it is checked again before deletion."""
    problems = []
    for aside in sorted(Path(source["dir"]).glob(f"**/{REAP_PREFIX}*")):
        try:
            restore(aside)
        except RuntimeError as error:
            problems.append(str(error))
    return problems


def reap(source, config, store, now):
    """Delete the finished files of a spool source whose every part the store holds.

    A producer may append to a file by name at any moment, so a file is renamed aside before
    its identity is checked a last time; a line appended after the rename creates a new file
    under the old name, and one appended through an earlier open changes the identity, which
    puts the file back. Returns the deleted count and the files that could not be put back.
    """
    problems = []
    deleted = set()
    for path, stat in finished(source, now):
        parts = pieces(source, path, stat, config)
        digests = ([blake3(path=path)] if parts is None
                   else [blake3(data=b"".join(lines)) for lines in parts])
        if not all(store.holds(digest) for digest in digests):
            continue
        aside = path.with_name(REAP_PREFIX + path.name)
        try:
            os.rename(path, aside)
        except FileNotFoundError:
            continue
        if identity(aside.lstat()) == identity(stat):
            aside.unlink()
            deleted.add(aside)
            continue
        try:
            restore(aside)  # Appended to while it was checked; the next run decides.
        except RuntimeError as error:
            problems.append(str(error))
    for parent in {path.parent for path in deleted}:
        fsync_directory(parent)
    return len(deleted), problems


def run(config):
    intake = Path(config["intake_root"])
    state = Path(config["state_dir"])
    state.mkdir(parents=True, exist_ok=True)
    # One shipper runs at a time.
    lock = open(state / "lock", "w")
    fcntl.flock(lock, fcntl.LOCK_EX)
    staging = state / ".staging"
    staging.mkdir(exist_ok=True)
    for leftover in staging.iterdir():
        leftover.unlink()
    queues = {}
    for source in config["source"]:
        if not (intake / source["name"]).is_dir():
            fail(f"consume root {intake / source['name']} is missing; create it and its watch first")
        queues[source["name"]] = state / "queue" / source["name"]
        queues[source["name"]].mkdir(parents=True, exist_ok=True)
    queued = sum(size for queue in queues.values() for _, size in waiting(queue))
    now = time.time()
    failures = 0
    # Files an interrupted run set aside go back first, so this run can ship them.
    reaped = [source for source in config["source"] if source.get("delete_acknowledged", False)]
    for source in reaped:
        for problem in restore_leftovers(source):
            failures += 1
            print(f"sparrow-ship: {source['name']}: {problem}", file=sys.stderr)
    for source in config["source"]:
        ledger_path = state / f"{source['name']}.ledger"
        shipped = set()
        if ledger_path.exists():
            shipped = ledger_keys(ledger_path)
        count = 0
        with open(ledger_path, "a") as ledger:
            for path, stat in finished(source, now):
                key = identity(stat)
                if key in shipped:
                    continue
                if count >= config["max_files_per_run"]:
                    print(f"sparrow-ship: {source['name']}: per-run file limit reached; resuming next run")
                    break
                if queued and queued >= config["max_queue_bytes"]:
                    print(f"sparrow-ship: {source['name']}: queue full; resuming next run")
                    break
                try:
                    queued += enqueue(source, path, stat, config, queues[source["name"]], staging)
                except (OSError, RuntimeError, subprocess.CalledProcessError) as error:
                    failures += 1
                    print(f"sparrow-ship: {source['name']}: {path}: {error}", file=sys.stderr)
                    continue
                ledger.write(f"{key}\t{path.relative_to(source['dir'])}\n")
                ledger.flush()
                os.fsync(ledger.fileno())
                shipped.add(key)
                count += 1
        print(f"sparrow-ship: {source['name']}: queued {count}")
    for name, count in feed(config, intake, queues).items():
        print(f"sparrow-ship: {name}: fed {count}")
    if reaped:
        try:
            store = Store(config)
            for source in reaped:
                count, problems = reap(source, config, store, time.time())
                print(f"sparrow-ship: {source['name']}: deleted {count} acknowledged")
                for problem in problems:
                    failures += 1
                    print(f"sparrow-ship: {source['name']}: {problem}", file=sys.stderr)
        except StoreUnreachable as error:
            print(f"sparrow-ship: store unreachable ({error}); no further spool file deleted")
    if failures:
        fail(f"{failures} file(s) failed; originals are untouched and will be retried")


if __name__ == "__main__":
    if len(sys.argv) != 2:
        fail("usage: sparrow-ship CONFIG.toml")
    run(load_config(sys.argv[1]))
