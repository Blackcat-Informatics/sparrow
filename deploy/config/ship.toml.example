# Installed as /etc/sparrow/ship.toml (root:sparrow 0640) by deploy/install.sh when absent.
# Each [[source]] NAME feeds the consume watch whose root is intake_root/NAME.
# state_dir must be on the same filesystem as intake_root: items are renamed into the roots.
# Create that directory and its watch (`sparrow ... watch put`) before shipping.
intake_root = "/SPARROW/intake"
state_dir = "/SPARROW/ship"
max_chunk_bytes = 1048576      # line formats are split above 1 MiB ...
max_chunk_lines = 50000        # ... or above 50,000 lines (max_records is 100,000);
                               # other formats ship whole, up to 7.93 GiB
max_files_per_run = 64         # per source
max_pending_bytes = 16777216   # all consume roots together
max_queue_bytes = 1073741824   # stop queueing new files while queues hold this much

# daily: dated files; the newest name may still be appended to.
[[source]]
name = "app-events"
dir = "/var/lib/app/events"
pattern = "*.jsonl"
rule = "daily"
format = "jsonl"
settle_seconds = 7200
exclude = []

# sealed: rotated segments, finished once NAME.manifest.json exists.
[[source]]
name = "app-segments"
dir = "/var/lib/app/log.segments"
pattern = "*.jsonl"
rule = "sealed"
format = "jsonl"
settle_seconds = 300

# settled: written-once documents, finished after a quiet period.
[[source]]
name = "app-reports"
dir = "/var/lib/app/reports"
pattern = "*.json"
rule = "settled"
format = "json"
settle_seconds = 600
