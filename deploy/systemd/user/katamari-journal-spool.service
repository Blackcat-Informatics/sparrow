#
# Interim user unit: spool katamari-stored's own lines from the katamari journal namespace. A copy of
# the live ~/.config/systemd/user/katamari-journal-spool.service, kept here from issue #168 on. Its
# script appends "-ns" to the cursor file name, so the cursor is katamari-journal-ns.cursor.

[Unit]
Description=Spool the katamari-stored journal as JSON Lines for sparrow-ship

[Service]
ExecStart=%h/.local/libexec/sparrow/katamari-journal-spool katamari-stored.service %S/sparrow/katamari-journal %S/sparrow/katamari-journal.cursor
Restart=always
RestartSec=10
Nice=10
MemoryMax=256M

[Install]
WantedBy=default.target
