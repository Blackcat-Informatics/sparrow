#
# The online backup client (deploy/libexec/sparrow-backup, installed as
# /usr/local/libexec/sparrow/sparrow-backup), run daily by sparrow-backup.timer. Installed verbatim
# as /etc/systemd/system/sparrow-backup.service.
#
# The backup is online (Patrick, 2026-11-08): the client asks the running daemon for a backup over
# its private socket and never stops, signals or drains sparrow.service, and takes no lock the
# shipper holds. The daemon copies its store into the backup_root of /etc/sparrow/server.toml, the
# NAS archive /net/synology/archives/sparrow, the only backup location: Sparrow never backs up to
# a local disk. The client then copies the image pair, lexicons, configuration, intake and the
# shipper's state beside it and writes their b3sum manifest, read back from the NAS. It runs as
# root to read those files; the NFS export must let root write the archive, or the unit must run
# as the daemon's user. The kernel NFS client carries the traffic, so the unit's private network
# and address-family limits do not apply to it.

[Unit]
Description=Online backup of the Sparrow service to the NAS archive
Documentation=file:///usr/local/share/doc/sparrow/deploy/README.md
RequiresMountsFor=/SPARROW /net/synology/archives/sparrow

[Service]
Type=oneshot
SyslogIdentifier=sparrow-backup
Environment=PATH=/usr/local/bin:/usr/bin
UMask=0077
# The daemon keeps backup_keep backups (server.toml); the client prunes the sets beside them.
ExecStart=/usr/local/libexec/sparrow/sparrow-backup /etc/sparrow/server.toml /SPARROW/intake /etc/sparrow /SPARROW/ship
# The first backup copies the whole store over the network; later ones copy only new tables.
TimeoutStartSec=6h

# A copy job (rsync, b3sum, sync and the CLI): bounded so a stuck or runaway run cannot crowd the
# daemon in the shared slice. Streaming copies and hashes need little memory.
MemoryMax=1G
TasksMax=64
CPUQuota=100%

# Lowest priority: the copies beside the store must not compete with ingestion (Patrick,
# 2026-11-08). Her slice, not real time.
Slice=lillith.slice
Nice=19
IOSchedulingClass=idle
# Section B's OOM ranking (2026-11-02): a helper carries a less protective value than the core
# service's -900, so a host OOM caused by its own work kills it, never the daemon. Value: -500.
OOMScoreAdjust=-500
RestrictRealtime=yes

# Not confined by AppArmor: a Python program that runs rsync, b3sum, sync and the sparrow CLI; its
# profile is a follow-up (deploy/RECOVERY.md, "Exposure"). It reads files it does not own and
# preserves no owners.
NoNewPrivileges=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/net/synology/archives/sparrow
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
