[Unit]
Description=Daily closed-store backup of the Sparrow service
Documentation=file:///usr/local/share/doc/sparrow/deploy/README.md

[Timer]
OnCalendar=*-*-* 04:00:00
RandomizedDelaySec=15min
Persistent=true

[Install]
WantedBy=timers.target
