#
# The shipper (deploy/libexec/sparrow-ship, installed as /usr/local/libexec/sparrow/sparrow-ship)
# copies finished producer files into the consume roots. Installed verbatim as
# /etc/systemd/system/sparrow-ship.service and run by sparrow-ship.timer.
#
# A system unit. It runs as the system user sparrow-ship (config/sysusers-sparrow.conf) and reads
# the producers' directories read-only; grant that user read access to each (a group or an ACL).
# Example producer directories live under /var/lib/app in config/ship.toml.example; edit them.
# Its state (queue, ledgers, lock) is /var/lib/sparrow/ship, on the same filesystem as /var/lib/sparrow/intake,
# because each queued item is renamed into its root. /var/lib/sparrow/ship is setgid sparrow, so every
# item it stages belongs to the sparrow group, and the shipper sets each item to mode 0640 so the
# daemon can read it.

[Unit]
Description=Copy finished producer files into Sparrow consume roots
Documentation=file:///usr/local/share/doc/sparrow/deploy/README.md
After=sparrow.service
RequiresMountsFor=/var/lib/sparrow

[Service]
Type=oneshot
User=sparrow-ship
Group=sparrow
SyslogIdentifier=sparrow-ship
ExecStart=/usr/local/libexec/sparrow/sparrow-ship /etc/sparrow/ship.toml
UMask=0077
MemoryMax=512M
TimeoutStartSec=30min

# A copy job: bounded so a stuck or runaway run cannot crowd the daemon.
TasksMax=64
CPUQuota=50%

# Priority: ahead of ordinary work, not real time.
Nice=-20
IOSchedulingClass=best-effort
IOSchedulingPriority=0
# OOM ranking: a helper carries a less protective value than the core service's -900, so a host
# OOM caused by its own work kills it, never the daemon. Value: -500.
OOMScoreAdjust=-500
RestrictRealtime=yes

# Not confined by AppArmor: it is a Python program that runs cp, and its profile is a follow-up
# (deploy/RECOVERY.md, "Exposure"). The systemd sandbox below confines its writes to its own state
# and the consume roots.
NoNewPrivileges=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/sparrow/ship /var/lib/sparrow/intake
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
PrivateIPC=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
