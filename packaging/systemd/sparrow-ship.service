[Unit]
Description=Copy finished producer files into Sparrow consume roots
After=sparrow.service

[Service]
Type=oneshot
ExecStart=%h/.local/libexec/sparrow/sparrow-ship %h/.config/sparrow/ship.toml
Nice=10
IOSchedulingClass=idle
MemoryMax=512M
