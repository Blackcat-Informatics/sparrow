[Unit]
Description=Sparrow typed diagnostic evidence server
# Bound restarts so a persistently refused store open stops instead of looping.
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
ExecStart=%h/.local/libexec/sparrow/sparrowd --config %h/.config/sparrow/server.toml
WorkingDirectory=%h
UMask=0077
# The daemon drains workers, synchronizes the WAL and removes its Unix socket
# through its SIGINT path. SIGTERM currently has no equivalent drain handler.
KillSignal=SIGINT
TimeoutStopSec=120
# Recover from crashes and host OOM kills. Startup removes a stale Unix socket
# only after it holds the store's exclusive lock, so a restart cannot open a
# second writer.
Restart=on-failure
RestartSec=10
# Throttle above 2 GiB and stop at 4 GiB, well above measured peaks (about 240 MB),
# so Sparrow cannot deepen a host-wide memory crisis.
MemoryHigh=2G
MemoryMax=4G

[Install]
WantedBy=default.target
