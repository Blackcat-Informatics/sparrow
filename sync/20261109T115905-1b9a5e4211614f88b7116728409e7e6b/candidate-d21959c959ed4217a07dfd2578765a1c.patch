+/// Latency percentile of `samples`, in microseconds.
+fn percentile(samples: &mut [u128], fraction: f64) -> u128 {
+    samples.sort_unstable();
+    let rank = ((samples.len() as f64 - 1.0) * fraction).round() as usize;
+    samples[rank]
+}
