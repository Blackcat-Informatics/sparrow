+    std::fs::write(
+        &old,
+        "#!/bin/sh\necho 'usage: sparrowd --config FILE.toml [--query-only | --no-intake] | sparrowd --restore-backup BACKUP_ROOT [BACKUP_ID] EMPTY_DIR' >&2\nexit 1\n",
+    )
+    .unwrap();
