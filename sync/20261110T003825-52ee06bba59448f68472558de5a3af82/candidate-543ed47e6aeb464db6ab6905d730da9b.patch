+# Wait up to LIMIT seconds for an entry other than .lock and SKIP in ROOT/.sparrow-inflight/,
+# and print its name.
+await_inflight() {
+    local root=$1 skip=$2 deadline=$((SECONDS + $3)) entry
+    while ((SECONDS < deadline)); do
