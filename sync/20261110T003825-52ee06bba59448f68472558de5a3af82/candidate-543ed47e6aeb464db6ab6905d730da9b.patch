+    std::os::unix::fs::symlink(env!("CARGO_BIN_EXE_sparrow"), images.join("sparrow-old")).unwrap();
+    let (code, _, stderr) = verify_backup_measured(
+        &backup,
+        &verify,
+        &live,
+        &[
+            "--measure-migration",
+            "--with-traffic",
+            "--image",
+            old.to_str().unwrap(),
