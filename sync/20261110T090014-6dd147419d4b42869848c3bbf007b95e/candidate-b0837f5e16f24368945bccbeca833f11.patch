+        .into_iter()
+        .flat_map(|scope| queries.iter().map(move |query| (scope, query)))
+        .map(|(scope, query)| {
+            let mut rows = scoped_answer(store, scope, RdfGraphLayers::ALL, query, now)
+                .0
+                .iter()
+                .map(|row| format!("{row:?}"))
+                .collect::<Vec<_>>();
