+#[derive(Debug, PartialEq)]
+struct OnlineAnswers {
+    context: [(Vec<String>, u64, sparrow_core::ContextFrontier); 2],
+    sources: Vec<(String, usize, usize, usize)>,
+    artifacts: Vec<(String, usize, bool)>,
