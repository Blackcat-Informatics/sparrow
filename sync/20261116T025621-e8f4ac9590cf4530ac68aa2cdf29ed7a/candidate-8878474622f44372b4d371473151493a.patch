+                        root_inode: inode,
+                        parent_device: device,
+                        parent_inode: inode,
+                    },
+                    path: b"file.log".to_vec(),
+                    source: "tail-boot".into(),
+                    format: "log".into(),
+                    device: file.dev(),
+                    inode: file.ino(),
+                },
+                crate::now().unwrap(),
+            )
+            .unwrap()
+    };
+    let config = ConsumeWatch {
+        id: "tail-boot".into(),
+        root: root.clone(),
+        producer_contract: crate::ProducerContract::ActiveFilesRetain,
+        source: "tail-boot".into(),
+        format: "log".into(),
+        quiet_ms: 30_000,
+        max_directories: 2,
+        max_candidates: 2,
+        publish_hold: false,
+    };
+    let open = || {
+        crate::tailing::TailRoot::open(
+            store.clone(),
+            &config,
+            1,
+            crate::consumption::RootBinding::Stored,
+        )
+    };
+
+    // Inode changed together with a stale device: refused, and nothing is gapped.
+    let changed = declare(
+        "changed-inode",
+        &first_meta,
+        root_meta.dev() + 1,
+        root_meta.ino() + 1,
