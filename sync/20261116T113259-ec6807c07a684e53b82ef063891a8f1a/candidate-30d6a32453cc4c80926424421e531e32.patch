-! grep -q 'sparrow-backup.timer' <<<"$(starts "$w")" || fail "success path started sparrow-backup.timer: $(starts "$w")"
-[[ -e $w/state/sparrow-ship.timer.active && ! -e $w/state/sparrow-backup.timer.active ]] \
