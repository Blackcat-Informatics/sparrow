-def rows_of(path, width):
-    if not Path(path).exists():
-        return []
-    rows = []
-    for line in Path(path).read_text().splitlines():
-        fields = line.split("\t")
-        if len(fields) != width:
-            fail(f"{path}: malformed row {line!r}")
-        rows.append((float(fields[0]), *fields[1:]))
-    return rows
-
-
-def cycled(path, cycle):
-    """Cycle 0 keeps the recorded name; later cycles add .cN before the suffix."""
-    name = Path(path).name
-    if cycle == 0:
-        return name
-    stem, dot, suffix = name.rpartition(".")
-    return f"{stem}.c{cycle}.{suffix}" if dot else f"{name}.c{cycle}"
-
-
-def replay(rows, window, stop, action):
-    """Run ACTION(cycle, index, row) at each row's offset, looping the window."""
-    if not rows:
-        return
-    start, cycle = time.monotonic(), 0
-    while True:
-        for index, row in enumerate(rows):
-            if not wait_until(stop, start + cycle * window + row[0]):
-                return
-            action(cycle, index, row)
-        cycle += 1
