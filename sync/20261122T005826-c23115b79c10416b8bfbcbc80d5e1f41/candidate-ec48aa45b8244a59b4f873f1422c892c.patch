+using Sparrow = import "sparrow.capnp";
+
+# The checkpoint is replaced atomically. Its cursor points immediately after the
+# last certified event; its optional seal describes the exact subsequent request.
+struct Header {
+  format @0 :Text;
+  source @1 :Text;
+  instance @2 :Data;
+  store @3 :Text;
+  spanEpoch @4 :UInt32;
+  confirmed @5 :UInt64;
