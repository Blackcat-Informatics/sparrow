+/// Transport-specific admission for the shared tool dispatcher.
+#[derive(Clone, Copy)]
+enum ToolAccess {
+    Stdio,
+    HttpRead,
+}
+
+impl ToolAccess {
+    fn allows(self, name: &str) -> bool {
+        match self {
+            Self::Stdio => tool::known(name),
+            Self::HttpRead => tool::http_read(name),
+        }
+    }
+
+    fn instructions(self) -> &'static str {
