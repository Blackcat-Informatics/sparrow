+    let mut text = std::fs::read_to_string(&config).unwrap();
+    text.push_str(&format!("backup_root = {root:?}\n"));
+    std::fs::write(&config, text).unwrap();
+    let output = Command::new(concat!(
+        env!("CARGO_MANIFEST_DIR"),
