@@ -0,0 +1,121 @@
+// SPDX-FileCopyrightText: 2026 Blackcat Informatics® Inc. <paudley@blackcatinformatics.ca>
+// SPDX-License-Identifier: MIT OR Apache-2.0 OR MulanPSL-2.0
+
+use super::Console;
+use crate::{
+    EventKind, EventLevel, FieldValue, ProducerEvent,
+    logging::{Fields, bounded_text, render},
+};
+use log::kv::{self, VisitSource, VisitValue};
+
+// Use the native log visitor so a u64 doesn't become text and an i128 doesn't narrow.
+struct Pair<'a> {
+    name: &'a str,
+    fields: &'a mut Fields,
+}
+
+fn invalid_field() -> kv::Error {
+    kv::Error::msg("Sparrow log field exceeds its capture bound")
+}
+
+impl<'v> VisitValue<'v> for Pair<'_> {
+    fn visit_any(&mut self, v: kv::Value<'_>) -> Result<(), kv::Error> {
+        let text = render(format_args!("{v:?}")).map_err(|()| invalid_field())?;
+        self.fields.push(self.name, FieldValue::Debug(text));
+        Ok(())
+    }
+    fn visit_str(&mut self, v: &str) -> Result<(), kv::Error> {
+        self.fields.push(
+            self.name,
+            FieldValue::Text(bounded_text(v).map_err(|()| invalid_field())?),
+        );
+        Ok(())
+    }
+    fn visit_i64(&mut self, v: i64) -> Result<(), kv::Error> {
+        self.fields.push(self.name, FieldValue::Signed(v));
+        Ok(())
+    }
+    fn visit_u64(&mut self, v: u64) -> Result<(), kv::Error> {
+        self.fields.push(self.name, FieldValue::Unsigned(v));
+        Ok(())
+    }
+    fn visit_i128(&mut self, v: i128) -> Result<(), kv::Error> {
+        self.fields.push(self.name, FieldValue::Signed128(v));
+        Ok(())
+    }
+    fn visit_u128(&mut self, v: u128) -> Result<(), kv::Error> {
+        self.fields.push(self.name, FieldValue::Unsigned128(v));
+        Ok(())
+    }
+    fn visit_f64(&mut self, v: f64) -> Result<(), kv::Error> {
+        self.fields
+            .push(self.name, FieldValue::Float64Bits(v.to_bits()));
+        Ok(())
+    }
+    fn visit_bool(&mut self, v: bool) -> Result<(), kv::Error> {
+        self.fields.push(self.name, FieldValue::Boolean(v));
+        Ok(())
+    }
+}
+
+impl<'v> VisitSource<'v> for Fields {
+    fn visit_pair(&mut self, key: kv::Key<'v>, value: kv::Value<'v>) -> Result<(), kv::Error> {
+        value.visit(Pair {
+            name: key.as_str(),
+            fields: self,
+        })?;
+        if self.failed() {
+            Err(invalid_field())
+        } else {
+            Ok(())
+        }
+    }
+}
+
+impl Console {
+    fn capture_record(&self, record: &log::Record<'_>) -> Result<ProducerEvent, ()> {
+        let mut fields = Fields::default();
+        fields.push("message", FieldValue::Text(render(*record.args())?));
+        record.key_values().visit(&mut fields).map_err(|_| ())?;
+        let event = ProducerEvent {
+            sequence: 0,
+            event_time: crate::unix_millis_now().map_err(|_| ())?,
+            kind: EventKind::Log,
+            level: match record.level() {
+                log::Level::Error => EventLevel::Error,
+                log::Level::Warn => EventLevel::Warn,
+                log::Level::Info => EventLevel::Info,
+                log::Level::Debug => EventLevel::Debug,
+                log::Level::Trace => EventLevel::Trace,
+            },
+            name: "log".into(),
+            target: bounded_text(record.target())?,
+            fields: fields.finish()?,
+            context: Vec::new(),
+            span: None,
+            follows_from: None,
+        };
+        crate::logging::in_current_span(event, &self.slots)
+    }
+}
+
+/// Use `log::set_boxed_logger(Box::new(console.clone()))` and set the desired
+/// `log::set_max_level` in an application that owns the process logger.
+impl log::Log for Console {
+    fn enabled(&self, _: &log::Metadata<'_>) -> bool {
+        true
+    }
+
+    fn log(&self, record: &log::Record<'_>) {
+        match self.capture_record(record) {
+            Ok(event) => self.emit(event),
+            Err(()) => self.capture_failed(),
+        }
+    }
+
+    fn flush(&self) {
+        // The synchronous facade has no result channel. A deliberate flush may wait for a
+        // slow console even inside a Tokio task, so the async API is preferable there.
+        let _ = self.flush_sync(false);
+    }
+}
diff --git crates/sparrow-client/src/console/render.rs crates/sparrow-client/src/console/render.rs
new file mode 100644
index 0000000..57ba47a
--- /dev/null
+++ crates/sparrow-client/src/console/render.rs
@@ -0,0 +1,130 @@
+// SPDX-FileCopyrightText: 2026 Blackcat Informatics® Inc. <paudley@blackcatinformatics.ca>
+// SPDX-License-Identifier: MIT OR Apache-2.0 OR MulanPSL-2.0
+
+use crate::{EventField, EventLevel, FieldValue, ProducerEvent};
+use std::{
+    fmt,
+    io::{self, Write},
+};
+
+struct Visible<'a>(&'a str, bool);
+const CONTINUATION: &str = "\n                  │ ";
+
+impl fmt::Display for Visible<'_> {
+    fn fmt(&self, out: &mut fmt::Formatter<'_>) -> fmt::Result {
+        use fmt::Write as _;
+        for ch in self.0.chars() {
+            match ch {
+                '\n' if self.1 => out.write_str(CONTINUATION)?,
+                ch if ch.is_control() => write!(out, "{}", ch.escape_default())?,
+                ch => out.write_char(ch)?,
+            }
+        }
+        Ok(())
+    }
+}
+
+fn value(out: &mut Vec<u8>, field: &FieldValue) -> io::Result<()> {
+    match field {
+        FieldValue::Text(s) | FieldValue::Debug(s) | FieldValue::Error(s) => {
+            write!(out, "{}", Visible(s, false))
+        }
+        FieldValue::Signed(n) => write!(out, "{n}"),
+        FieldValue::Unsigned(n) => write!(out, "{n}"),
+        FieldValue::Signed128(n) => write!(out, "{n}"),
+        FieldValue::Unsigned128(n) => write!(out, "{n}"),
+        FieldValue::Float64Bits(bits) => write!(out, "{}", f64::from_bits(*bits)),
+        FieldValue::Boolean(flag) => write!(out, "{flag}"),
+        FieldValue::Bytes(bytes) => write!(out, "0x{}", purrdf_hash::hex::encode(bytes)),
+    }
+}
+
+pub(super) struct Line {
+    event_time: u64,
+    level: EventLevel,
+    target: String,
+    name: String,
+    fields: Vec<EventField>,
+    span: Option<String>,
+}
+
+impl Line {
+    // The local queue owns only what it prints. Copy no ancestry or span fields, and
+    // transfer the event's allocations outright when the console is its only destination.
+    pub(super) fn capture(event: &mut ProducerEvent, retain: bool) -> Self {
+        let span = event.context.last().map(|span| span.name.clone());
+        let (name, target, fields) = if retain {
+            (
+                event.name.clone(),
+                event.target.clone(),
+                event.fields.clone(),
+            )
+        } else {
+            (
+                std::mem::take(&mut event.name),
+                std::mem::take(&mut event.target),
+                std::mem::take(&mut event.fields),
+            )
+        };
+        Self {
+            event_time: event.event_time,
+            level: event.level,
+            target,
+            name,
+            fields,
+            span,
+        }
+    }
+}
+
+pub(super) fn line(out: &mut Vec<u8>, event: &Line, color: bool) -> io::Result<()> {
+    let sec = event.event_time / 1000;
+    let (label, style) = match event.level {
+        EventLevel::Trace => ("TRACE", "\x1b[2m"),
+        EventLevel::Debug => ("DEBUG", "\x1b[36m"),
+        EventLevel::Info => ("INFO", "\x1b[32m"),
+        EventLevel::Warn => ("WARN", "\x1b[1;33m"),
+        EventLevel::Error => ("ERROR", "\x1b[1;31m"),
+    };
+    let dim = if color { "\x1b[2m" } else { "" };
+    let reset = if color { "\x1b[0m" } else { "" };
+    let style = if color { style } else { "" };
+    write!(
+        out,
+        "{dim}{:02}:{:02}:{:02}{reset}  {style}{label:<5}{reset}  {dim}{}{reset}  ",
+        sec / 3600 % 24,
+        sec / 60 % 60,
+        sec % 60,
+        Visible(&event.target, false)
+    )?;
+    let message = event.fields.iter().position(|f| f.name == "message");
+    let text = match message.map(|i| &event.fields[i].value) {
+        Some(FieldValue::Text(s) | FieldValue::Debug(s) | FieldValue::Error(s)) => Some(s.as_str()),
+        None => Some(event.name.as_str()),
+        Some(other) => {
+            value(out, other)?;
+            None
+        }
+    };
+    let mut continuation = None;
+    if let Some(text) = text {
+        let (first, detail) = text
+            .split_once('\n')
+            .map_or((text, None), |(a, b)| (a, Some(b)));
+        write!(out, "{}", Visible(first, false))?;
+        continuation = detail;
+    }
+    for (idx, field) in event.fields.iter().enumerate() {
+        if Some(idx) != message {
+            write!(out, "  {dim}{}={reset}", Visible(&field.name, false))?;
+            value(out, &field.value)?;
+        }
+    }
+    if let Some(span) = &event.span {
+        write!(out, "  {dim}in {}{reset}", Visible(span, false))?;
+    }
+    if let Some(details) = continuation {
+        write!(out, "{CONTINUATION}{}", Visible(details, true))?;
+    }
+    writeln!(out)
+}
